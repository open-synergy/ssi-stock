<odoo>
<data noupdate="1">
<!-- CREATE ACCOUNTING ENTRIES -->
<record
            id="stock_picking_policy_template_detail_create_accounting_entries"
            model="policy.template_detail"
        >
    <field name="template_id" ref="ssi_stock.stock_picking_policy_template" />
    <field
                name="field_id"
                search="[('model_id.model','=','stock.picking'),('name','=','accounting_entry_create_ok')]"
            />
    <field name="restrict_state" eval="0" />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
                name="group_ids"
                eval="[(6,0,[ref('ssi_financial_accounting.journal_entry_user_group')])]"
            />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if document.create_accounting_entry_ok:
    result = True
    </field>
</record>

<!-- DELETE ACCOUNTING ENTRIES -->
<record
            id="stock_picking_policy_template_detail_delete_accounting_entries"
            model="policy.template_detail"
        >
    <field name="template_id" ref="ssi_stock.stock_picking_policy_template" />
    <field
                name="field_id"
                search="[('model_id.model','=','stock.picking'),('name','=','accounting_entry_delete_ok')]"
            />
    <field name="restrict_state" eval="0" />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
                name="group_ids"
                eval="[(6,0,[ref('ssi_financial_accounting.journal_entry_user_group')])]"
            />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if not document.create_accounting_entry_ok:
    result = True
    </field>
</record>

