<odoo>
<!-- SEARCH VIEW -->
<record id="stock_picking_type_view_search" model="ir.ui.view">
    <field name="name">stock.picking.type: Operating Unit Search</field>
    <field name="model">stock.picking.type</field>
    <field name="inherit_id" ref="ssi_stock.stock_picking_type_view_search" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='category_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
            <xpath
                    expr="//filter[@name='grp_picking_type_category_id']"
                    position="after"
                >
                <filter
                        name="grp_ou"
                        string="Operating Unit"
                        context="{'group_by':'operating_unit_id'}"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>
<!-- TREE VIEW -->
<record id="stock_picking_type_view_tree" model="ir.ui.view">
    <field name="name">stock.picking.type: Operating Unit Tree</field>
    <field name="model">stock.picking.type</field>
    <field name="inherit_id" ref="ssi_stock.stock_picking_type_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='category_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>
<!-- FORM VIEW -->
<record id="stock_picking_type_view_form" model="ir.ui.view">
    <field name="name">stock.picking.type: Operating Unit Form</field>
    <field name="model">stock.picking.type</field>
    <field name="inherit_id" ref="ssi_stock.stock_picking_type_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='category_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>
</odoo>
