<odoo>
<!-- Picking Type: Rule -->
<record id="stock_picking_type_rule_ou" model="ir.rule">
    <field name="name">Stock Picking Type - Responsible to operating unit data</field>
    <field name="model_id" ref="stock.model_stock_picking_type" />
    <field name="groups" eval="[(5,)]" />
    <field name="domain_force">['|', ('operating_unit_id','=',False),
        ('operating_unit_id','in',user.operating_unit_ids.ids)]</field>
    <field eval="0" name="perm_unlink" />
    <field eval="0" name="perm_write" />
    <field eval="1" name="perm_read" />
    <field eval="0" name="perm_create" />
</record>

